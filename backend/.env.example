# Obrigatória: assina as sessões de login. Gere a sua com
# python3 -c "import secrets; print(secrets.token_hex(32))"
# (./start.sh e start.bat já geram isso automaticamente na primeira vez)
SECRET_KEY=

# Obrigatória: string de conexão do Postgres.
# Supabase: Project Settings -> Database -> Connection string -> URI
# (use a "Connection pooling" URI se disponível, funciona melhor com
# conexões curtas como as deste backend)
DATABASE_URL=

# Obrigatórias para upload de fotos/vídeos/áudios (Supabase Storage).
# Project Settings -> API -> Project URL / service_role key.
# SUPABASE_SERVICE_KEY é secreta — nunca exponha no front-end.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=pegasus-uploads

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Opcionais: só necessárias para o Agente de Triagem IA ler uma caixa de
# e-mail de verdade (sem elas, a rota /api/emails retorna um erro claro
# explicando o que falta). EMAIL_IMAP_PASSWORD é uma "senha de app" do
# Gmail (myaccount.google.com/apppasswords, exige verificação em 2 etapas
# ativada) — nunca a senha normal da conta. Veja o README para o passo a
# passo completo.
# EMAIL_IMAP_HOST=imap.gmail.com
# EMAIL_IMAP_USER=seuemail@gmail.com
# EMAIL_IMAP_PASSWORD=

# Uncomment to restrict the backend to this machine only (default is 0.0.0.0,
# reachable from other devices on the same local network):
# HOST=127.0.0.1
# PORT=5000
